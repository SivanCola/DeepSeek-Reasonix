<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted, and the platform has no way to permit less.

  Two kinds of page load over plain HTTP: the kernel's own page on
  `127.0.0.1:<port>`, and the same page served by a paired computer on whatever
  address its router handed out. The port is chosen when the kernel starts and
  the LAN address when a code is scanned, so neither can be written here — and a
  `domain-config` matches literals and domains, never a subnet.

  So the boundary is not this file. `MainActivity` decides which cleartext origin
  may become the window: `shouldOverrideUrlLoading` sends every http(s) origin
  that is not the kernel's or the one just paired out to the browser, and the
  native bridge answers only those two. A plaintext page on the LAN therefore
  cannot become the document holding the bridge, which is what the reviewer's
  "deliberate path for LAN pairing" asks for.

  HTTPS is untouched: nothing here downgrades a request, and `trust-anchors`
  keeps the system roots for every TLS connection that is made.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
